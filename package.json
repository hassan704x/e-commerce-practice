  "license": "ISC",
  "description": "",
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "dotenv": "^17.2.1",
    "express": "^4.18.3",
    "framer-motion": "^10.18.0",
    "mongoose": "^8.16.4",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.10",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
